{
  "name": "webgpu-ed25519",
  "version": "0.1.0",
  "description": "Ed25519 key derivation and vanity address finder running on WebGPU — works in-browser, no backend",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./vanity": {
      "import": "./dist/vanity/index.js",
      "types": "./dist/vanity/index.d.ts"
    },
    "./primitives": {
      "import": "./dist/primitives/index.js",
      "types": "./dist/primitives/index.d.ts"
    }
  },
  "files": ["dist", "LICENSE", "LICENSE-APACHE"],
  "keywords": [
    "solana", "stellar", "algorand", "ton",
    "ed25519", "webgpu", "crypto", "vanity", "keypair",
    "wgsl", "compute-shader"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/trixky/webgpu-ed25519.git"
  },
  "scripts": {
    "build":        "tsc -p tsconfig.build.json",
    "test":         "vitest run",
    "test:node":    "vitest run --project node",
    "test:gpu":     "vitest run --project browser",
    "test:layer1":  "vitest run --project browser --reporter=verbose test/gpu/primitives",
    "test:layer2":  "vitest run --project browser --reporter=verbose test/gpu/derive",
    "test:layer3":  "vitest run --project browser --reporter=verbose test/gpu/vanity",
    "test:stress":  "vitest run --project browser --reporter=verbose test/gpu/stress",
    "test:watch":   "vitest --project browser",
    "lint":         "tsc --noEmit",
    "bench":        "node --experimental-vm-modules bench/benchmark.ts"
  },
  "devDependencies": {
    "@noble/curves": "^1.8.0",
    "@noble/hashes": "^1.7.0",
    "@types/node": "^22.0.0",
    "@vitest/browser": "^3.0.0",
    "playwright": "^1.50.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
